@startuml 01_usecase
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F1EFE8
  BorderColor #3C3489
  ArrowColor #3C3489
  FontColor #26215C
}
skinparam actor {
  BorderColor #26215C
  FontColor #26215C
}
skinparam rectangle {
  BorderColor #26215C
  FontColor #26215C
  FontStyle bold
}
skinparam note {
  BackgroundColor #FBF0E2
  BorderColor #B75E09
}

' ---------- Primary (human) actors -- left ----------
actor Admin
actor Teacher
actor Student

rectangle "SmartSchool System" {
  usecase "Register"                 as UC_REG
  usecase "Log In"                   as UC_LOGIN
  usecase "Manage Courses"           as UC_COURSE
  usecase "Enroll in a Course"       as UC_ENROLL
  usecase "Record a Grade"           as UC_GRADE
  usecase "View Grades"              as UC_VIEWGRADE
  usecase "View Academic\nReports"   as UC_REPORT
  usecase "View Invoices"            as UC_INVOICE
  usecase "Create Invoice\n(async)"  as UC_CREATEINV
}

' ---------- Secondary (system) actor -- right ----------
actor "Message Broker\n(RabbitMQ)" as Broker

' ---------- Primary actor associations ----------
Admin --> UC_REG
Admin --> UC_LOGIN
Admin --> UC_COURSE
Admin --> UC_ENROLL
Admin --> UC_REPORT

Teacher --> UC_LOGIN
Teacher --> UC_REPORT
Teacher --> UC_GRADE

Student --> UC_REG
Student --> UC_LOGIN
Student --> UC_ENROLL
Student --> UC_VIEWGRADE
Student --> UC_INVOICE

' ---------- Secondary actor association ----------
UC_CREATEINV -- Broker

' ---------- <<include>>: base use case ..> included use case ----------
UC_COURSE  ..> UC_LOGIN : <<include>>
UC_ENROLL  ..> UC_LOGIN : <<include>>
UC_GRADE   ..> UC_LOGIN : <<include>>
UC_REPORT  ..> UC_LOGIN : <<include>>
UC_VIEWGRADE ..> UC_LOGIN : <<include>>
UC_INVOICE ..> UC_LOGIN : <<include>>

' ---------- <<extend>>: extending use case ..> base use case ----------
UC_CREATEINV ..> UC_ENROLL : <<extend>>

note bottom of UC_CREATEINV
  Extension, not a direct call: Finance
  Service creates this invoice by reacting
  to the enrollment.created event, using
  the Message Broker as an intermediary.
end note
@enduml
