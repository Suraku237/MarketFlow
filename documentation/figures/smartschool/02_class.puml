@startuml 02_class
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F1EFE8
  BorderColor #3C3489
  ArrowColor #3C3489
  FontColor #26215C
  HeaderBackgroundColor #3C3489
}
skinparam note {
  BackgroundColor #FBF0E2
  BorderColor #B75E09
}
hide circle
hide empty members

' ---------- Enumerations (value types, not modelled via inheritance) ----------
enum EnrollmentStatus {
  active
  completed
  dropped
}

enum InvoiceStatus {
  pending
  paid
  cancelled
}

enum AssessmentType {
  quiz
  assignment
  midterm
  final
}

' ---------- Abstraction: abstract base class + interface ----------
abstract class Person {
  +id: int
  +name: string
  +email: string
  +createdAt: datetime
  --
  +{abstract} authenticate(password): boolean
}

interface Payable {
  +pay(): void
  +status(): string
}

' ---------- Inheritance ----------
class Admin {
  --
  +createCourse(...): Course
  +createPayrollRun(period): PayrollRun
}

class Teacher {
  --
  +recordGrade(enrollmentId, type, score): Grade
}

class Student {
  +admissionNumber: string
  +dateOfBirth: date
  +guardianName: string
  +guardianPhone: string
  +enrolledOn: date
  --
  +enroll(courseId): Enrollment
}

Person <|-- Admin
Person <|-- Teacher
Person <|-- Student

' ---------- Plain classes ----------
class Course {
  +id: int
  +code: string
  +name: string
  +credits: int
  +feeAmount: decimal
  +term: string
}

class Enrollment {
  +id: int
  +status: EnrollmentStatus
  +enrolledAt: datetime
}

class Grade {
  +id: int
  +assessmentType: AssessmentType
  +score: decimal
  +recordedAt: datetime
}

class Invoice {
  +id: int
  +amount: decimal
  +momoReference: string
  +method: string
  +status: InvoiceStatus
  +issuedAt: datetime
  +paidAt: datetime
}

class PayrollRun {
  +id: int
  +periodStart: date
  +periodEnd: date
  +status: string
  +runDate: datetime
}

class Payslip {
  +id: int
  +baseSalary: decimal
  +deductions: decimal
  +netPay: decimal
  +momoReference: string
  +status: string
}

' ---------- Abstraction: realization ----------
Invoice ..|> Payable
Payslip ..|> Payable

' ---------- Associations ----------
Teacher  "1" --  "0..*" Course     : teaches >
Teacher  "1" --  "0..*" Grade      : records >
Admin    "1" --  "0..*" PayrollRun : creates >
Person   "1" --  "0..*" Payslip    : receives >

' ---------- Composition (filled diamond -- part cannot outlive the whole) ----------
Student    "1" *-- "0..*" Enrollment : owns
Enrollment "1" *-- "0..*" Grade      : contains
Enrollment "1" *-- "0..1" Invoice    : generates

' ---------- Aggregation (hollow diamond -- part can exist / be reassigned independently) ----------
Course     "1" o-- "0..*" Enrollment : has roster
PayrollRun "1" o-- "0..*" Payslip    : contains

note top of Person
  <b>Abstraction + Inheritance.</b>
  Admin, Teacher and Student all
  specialize Person. The physical
  schema implements this hierarchy
  as a single "users" table with a
  "role" discriminator column
  (single-table inheritance) rather
  than one table per subclass --
  see the ERD (Section 4.1).
end note

note bottom of Payable
  <b>Abstraction via interface.</b>
  Invoice and Payslip both realize
  Payable so a future reconciliation
  workflow (Week 5/6) can treat both
  polymorphically.
end note

note right of Invoice
  amount is a fee snapshot taken
  at enrollment time, not a live
  reference to Course::feeAmount --
  a later fee change never alters
  an already-issued invoice.
end note

note bottom of Payslip
  Payroll module: data model
  complete (Week 2), service
  layer planned for Week 5.
end note
@enduml
