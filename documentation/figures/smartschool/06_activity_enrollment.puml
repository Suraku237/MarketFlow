@startuml 06_activity_enrollment
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam activity {
  BackgroundColor #F1EFE8
  BorderColor #3C3489
  ArrowColor #3C3489
  FontColor #26215C
  DiamondBackgroundColor #FBF0E2
  DiamondBorderColor #B75E09
}
skinparam swimlane {
  BorderColor #26215C
  TitleBackgroundColor #3C3489
  TitleFontColor white
}

|Student|
start
:Select a course;
:Submit POST /api/v1/enrollments;

|Academic Service|
if (Already enrolled in this course?) then (yes)
  |Student|
  :Receive 409 Conflict;
  stop
else (no)
  |Academic Service|
  :Insert enrollment row;
  :Commit transaction to MySQL;

  fork
    :Return 201 Created;
    |Student|
    :Enrollment confirmed;
  fork again
    |Academic Service|
    :Publish "enrollment.created"\n(persistent, fire-and-forget);

    |RabbitMQ|
    :Queue message durably\nin school_events exchange;

    |Finance Service|
    :Consume event whenever ready;
    if (Invoice already exists\nfor this enrollment?) then (yes)
      :Acknowledge message, no-op;
    else (no)
      :Insert invoice\n(status = pending, amount = fee snapshot);
      :Acknowledge message;
    endif
  end fork
  stop
endif
@enduml
