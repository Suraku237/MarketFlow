PORT=8080
JWT_SECRET=change-this-to-a-long-random-string-in-real-deployments

# Where the Gateway forwards requests to (Docker service names when run via
# docker-compose; localhost + distinct ports when run standalone)
AUTH_SERVICE_URL=http://localhost:3000
ACADEMIC_SERVICE_URL=http://localhost:4000

# "Block a user after 10 requests in 1 minute"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
