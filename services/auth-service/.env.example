PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-in-real-deployments
JWT_EXPIRES_IN=1h

# MySQL connection (matches the `db` service in docker-compose.yml; if
# running the service directly with `npm start` against a locally installed
# MySQL instead of Docker, point these at that instead)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=dev-only-change-me
DB_NAME=smartschool
